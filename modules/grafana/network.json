{
  "uid": "network",
  "title": "Network",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      },
      {
        "name": "iface",
        "label": "Interface",
        "type": "query",
        "query": {
          "qryType": 1,
          "query": "label_values(node_network_receive_bytes_total, device)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "regex": "/^(?:en|eth).*/",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "allValue": "(en|eth).*",
        "definition": "label_values(node_network_receive_bytes_total, device)"
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Download",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "E"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (device) (rate(node_network_receive_bytes_total{device=~\"$iface\"}[$__rate_interval])) * 8",
          "legendFormat": "{{device}} down"
        },
        {
          "refId": "C",
          "expr": "qbittorrent_global_download_rate_limit_bytes * 8",
          "legendFormat": "qBittorrent down limit"
        },
        {
          "refId": "E",
          "expr": "qbittorrent_global_download_speed_bytes * 8",
          "legendFormat": "qBittorrent down"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Upload",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "D"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "E"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "F"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "B",
          "expr": "sum by (device) (rate(node_network_transmit_bytes_total{device=~\"$iface\"}[$__rate_interval])) * 8",
          "legendFormat": "{{device}} up"
        },
        {
          "refId": "D",
          "expr": "qbittorrent_global_upload_rate_limit_bytes * 8",
          "legendFormat": "qBittorrent up limit"
        },
        {
          "refId": "E",
          "expr": "qbittorrent_global_upload_speed_bytes * 8",
          "legendFormat": "qBittorrent up"
        },
        {
          "refId": "F",
          "expr": "rate(systemd_service_ip_egress_bytes{name=\"plex.service\"}[$__rate_interval]) * 8",
          "legendFormat": "Plex up"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Download (5m average)",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "E"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(node_network_receive_bytes_total{device=~\"$iface\"}[5m])) * 8",
          "legendFormat": "down"
        },
        {
          "refId": "C",
          "expr": "qbittorrent_global_download_rate_limit_bytes * 8",
          "legendFormat": "qBittorrent down limit"
        },
        {
          "refId": "E",
          "expr": "avg_over_time(qbittorrent_global_download_speed_bytes[5m]) * 8",
          "legendFormat": "qBittorrent down"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Upload (5m average)",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "D"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "E"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "F"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "B",
          "expr": "sum(rate(node_network_transmit_bytes_total{device=~\"$iface\"}[5m])) * 8",
          "legendFormat": "up"
        },
        {
          "refId": "D",
          "expr": "qbittorrent_global_upload_rate_limit_bytes * 8",
          "legendFormat": "qBittorrent up limit"
        },
        {
          "refId": "E",
          "expr": "avg_over_time(qbittorrent_global_upload_speed_bytes[5m]) * 8",
          "legendFormat": "qBittorrent up"
        },
        {
          "refId": "F",
          "expr": "rate(systemd_service_ip_egress_bytes{name=\"plex.service\"}[5m]) * 8",
          "legendFormat": "Plex up"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Downloaded (24h)",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(node_network_receive_bytes_total{device=~\"$iface\"}[24h]))"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Uploaded (24h)",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(node_network_transmit_bytes_total{device=~\"$iface\"}[24h]))"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    }
  ]
}
